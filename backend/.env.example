# Development works with SQLite when DATABASE_URL is omitted.
# Use PostgreSQL for production; generate a real secret locally.
FLASK_ENV=development
SECRET_KEY=
DATABASE_URL=
FRONTEND_URL=http://127.0.0.1:5173
# Self-hosting on one PC: keep the local SQLite file in production (never on Vercel).
ALLOW_SQLITE_IN_PRODUCTION=false
# Number of trusted reverse proxies in front of the app (1 for Cloudflare Tunnel, 0 when exposed directly).
TRUSTED_PROXY_HOPS=0
COMPANY_NAME=Workday
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=10485760
ALLOW_OVERNIGHT=false
RATELIMIT_STORAGE_URI=memory://
PDF_FONT_PATH=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
