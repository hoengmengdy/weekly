{
  "name": "website-tutorial",
  "version": "1.0.0",
  "description": "Khmer Workday user tutorial: 160 seconds, 1080p, nine editable chapters",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/player": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 3100 --strictPort",
    "studio": "node node_modules/@remotion/cli/remotion-cli.js studio --no-open --port 3101",
    "build": "node node_modules/vite/bin/vite.js build && node node_modules/@remotion/cli/remotion-cli.js bundle",
    "upgrade": "node node_modules/@remotion/cli/remotion-cli.js upgrade",
    "lint": "node node_modules/eslint/bin/eslint.js src && node node_modules/typescript/bin/tsc",
    "render": "node node_modules/@remotion/cli/remotion-cli.js render Workday-Khmer-Guide public/workday-khmer-guide.mp4 --codec=h264 --crf=23",
    "test": "node node_modules/@playwright/test/cli.js test",
    "check:audio": "python verify_audio.py",
    "sync:download": "python sync_download.py"
  },
  "allowScripts": {
    "esbuild": false
  }
}
